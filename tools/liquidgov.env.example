# Copy this file to: tools/.liquidgov.env  (this repo's .gitignore will ignore it)
#
# Then load it in your shell:
#   set -a && source tools/.liquidgov.env && set +a
#
# Do NOT commit tools/.liquidgov.env (it contains secrets).

CPANEL_HOST=host04.nunames.net
CPANEL_PORT=2083
CPANEL_USER=liquidgo
CPANEL_PASS=PUT_YOUR_CPANEL_PASSWORD_HERE

# Optional: override remote root if your docroot differs.
# LIQUIDGOV_REMOTE_ROOT=/home/liquidgo/public_html

# Optional: disable TLS verification (NOT recommended)
# CPANEL_INSECURE=1

